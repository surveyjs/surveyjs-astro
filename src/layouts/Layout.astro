---
import AppHeader from '../components/AppHeader.vue'
import '../styles/main.css'

interface Props {
  title?: string
}

const { title = 'SurveyJS + Astro Quickstart Template' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Quick start template for SurveyJS Form Library, Survey Creator, Dashboard, and PDF Generator in Astro"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <AppHeader client:load currentPath={currentPath} />
    <main>
      <slot />
    </main>
  </body>
</html>
